# ===== Wajib =====
# Nomor WhatsApp yang jadi BOT (untuk login pairing code). Format internasional, tanpa + / spasi.
PAIRING_NUMBER=628xxxxxxxxxx
# Nomor owner (boleh lebih dari satu, pisahkan koma)
OWNER_NUMBERS=628xxxxxxxxxx

# ===== Umum =====
BOT_NAME=WaBot
PREFIX=.
# Folder penyimpanan sesi + pengaturan. Di Railway arahkan ke mount path Volume (mis. /data)
DATA_DIR=./data

# ===== AI (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Downloader =====
MAX_MEDIA_MB=64
MAX_DOWNLOADS=2
# Opsional: path file cookies.txt untuk YouTube (lihat README)
YTDLP_COOKIES=
