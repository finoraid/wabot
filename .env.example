# ===== Login =====
# qr   = buka https://<domain-railway>/qr?key=<QR_KEY> lalu scan (disarankan, pairing code sedang bermasalah di Baileys)
# code = pairing code di log Railway (butuh PAIRING_NUMBER)
LOGIN_MODE=qr
# Kunci halaman /qr. Isi string acak panjang (>= 20 karakter). Kosong = halaman QR mati.
QR_KEY=
# Hanya untuk LOGIN_MODE=code: nomor WhatsApp BOT, format internasional tanpa + / spasi.
PAIRING_NUMBER=

# ===== Wajib =====
# Nomor owner (boleh lebih dari satu, pisahkan koma)
OWNER_NUMBERS=628xxxxxxxxxx

# ===== Umum =====
BOT_NAME=WaBot
PREFIX=.
# Folder penyimpanan sesi + pengaturan. Di Railway arahkan ke mount path Volume (mis. /data)
DATA_DIR=./data

# ===== AI (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Downloader =====
MAX_MEDIA_MB=64
MAX_DOWNLOADS=2
# Opsional: path file cookies.txt untuk YouTube (lihat README)
YTDLP_COOKIES=
